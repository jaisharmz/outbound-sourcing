# Copy this file to config/secrets.env and fill it in.
# secrets.env is gitignored. Never commit real values.
#
# There is no OAuth and no Google Cloud project. This tool sends over SMTP and
# writes drafts over IMAP, both with a 16-character app password.

# Required. Google account -> 2-Step Verification must be ON, then create one at
# myaccount.google.com/apppasswords. Spaces in the value are fine.
SMTP_APP_PASSWORD=

# Strongly recommended. A fine-grained GitHub token with NO scopes selected --
# public read is the default and is all the email-pattern channel needs.
# Without it you get 60 requests an hour and most runs find nothing.
# github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
